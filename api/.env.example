# Copy to .env for running the API outside Docker. Never commit .env.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Matches the "db" service in docker-compose.yml
DATABASE_URL=postgresql://tesla:tesla@localhost:5433/tesla
DATABASE_POOL_MAX=5
SESSION_TTL_HOURS=12
TRUST_PROXY_HOPS=1
# The batching window: how often waiting requests are matched to running trips (D-023).
MATCH_INTERVAL_MS=2000
