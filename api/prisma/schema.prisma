// Database schema for Dhaka Tesla Pool.
// Tables are added together with the feature that needs them.
// CHECK constraints and partial unique indexes cannot be written here;
// they live in migration SQL and are shown in docs/system-overview.pdf.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Set explicitly instead of letting Prisma guess from tsconfig.json,
  // so the generated imports are the same on every machine and in Docker.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PASSENGER
  DRIVER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  // Always stored in lower case, so "Nusrat@x.com" and "nusrat@x.com" are the same account.
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sessions   Session[]
  vehicle    Vehicle?
  rides      RideRequest[]
  rideEvents RideEvent[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 of the cookie token. The raw token is never stored.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// One of the predefined Dhaka zones (see docs/assumptions.md §3).
model Zone {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique // e.g. "BAN"
  name String @unique // e.g. "Banani"

  distancesFrom ZoneDistance[] @relation("DistanceFrom")
  distancesTo   ZoneDistance[] @relation("DistanceTo")
  routeStops    RouteStop[]
  vehiclesHere  Vehicle[]
  ridePickups   RideRequest[]  @relation("RidePickup")
  rideDropoffs  RideRequest[]  @relation("RideDropoff")

  @@map("zones")
}

// Road distance between two different zones, in whole kilometres.
// Stored in both directions (A→B and B→A) so a lookup is one row.
model ZoneDistance {
  fromZoneId String @map("from_zone_id") @db.Uuid
  toZoneId   String @map("to_zone_id") @db.Uuid
  km         Int

  fromZone Zone @relation("DistanceFrom", fields: [fromZoneId], references: [id], onDelete: Cascade)
  toZone   Zone @relation("DistanceTo", fields: [toZoneId], references: [id], onDelete: Cascade)

  @@id([fromZoneId, toZoneId])
  @@map("zone_distances")
}

// A fixed Tesla route, one direction only (see docs/assumptions.md §3.3).
model Route {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique // e.g. "UTT-BSH"
  name String @unique // e.g. "Uttara → Bashundhara"

  stops    RouteStop[]
  vehicles Vehicle[]
  pools    Pool[]

  @@map("routes")
}

// The zones of a route in driving order. position 0 is the first stop.
model RouteStop {
  routeId     String @map("route_id") @db.Uuid
  position    Int
  zoneId      String @map("zone_id") @db.Uuid
  kmFromStart Int    @map("km_from_start") // route km from the first stop to this one

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  zone  Zone  @relation(fields: [zoneId], references: [id])

  @@id([routeId, position])
  @@unique([routeId, zoneId])
  @@map("route_stops")
}

// One status set for both ride requests and pools (docs/assumptions.md §5).
// A pool is never REQUESTED; a request is REQUESTED until it gets a seat.
enum RideStatus {
  REQUESTED
  MATCHED
  DRIVER_ARRIVED
  STARTED
  COMPLETED
  CANCELLED
}

// A driver's vehicle. The row is also the lock for every seat change (RidesRepository.withVehicleLock).
model Vehicle {
  id            String   @id @default(uuid()) @db.Uuid
  driverId      String   @unique @map("driver_id") @db.Uuid // one vehicle per driver
  name          String
  seatCapacity  Int      @map("seat_capacity")
  isOnline      Boolean  @default(false) @map("is_online")
  routeId       String?  @map("route_id") @db.Uuid // the route the driver drives now; null until chosen
  currentZoneId String?  @map("current_zone_id") @db.Uuid // where the vehicle is; updated at every stop
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  driver      User   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route       Route? @relation(fields: [routeId], references: [id])
  currentZone Zone?  @relation(fields: [currentZoneId], references: [id])
  pools       Pool[]

  @@map("vehicles")
}

// One trip of a vehicle along its route. status says where the vehicle is:
// MATCHED = heading to the first pickup, DRIVER_ARRIVED = at current_stop,
// STARTED = driving to current_stop, then COMPLETED or CANCELLED.
model Pool {
  id                  String     @id @default(uuid()) @db.Uuid
  vehicleId           String     @map("vehicle_id") @db.Uuid
  routeId             String     @map("route_id") @db.Uuid
  currentStop         Int        @map("current_stop") // position the vehicle is at or heading to
  status              RideStatus @default(MATCHED)
  // Copied from the vehicle when the pool is created, so the CHECK can compare two columns.
  seatCapacity        Int        @map("seat_capacity")
  seatsTaken          Int        @default(0) @map("seats_taken")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt           DateTime?  @map("started_at") @db.Timestamptz(6)
  endedAt             DateTime?  @map("ended_at") @db.Timestamptz(6)
  // Who gets what, locked when the trip is COMPLETED (docs/assumptions.md §7.2).
  collectedPaisa      Int?       @map("collected_paisa") // all final fares, paid in cash
  driverEarningsPaisa Int?       @map("driver_earnings_paisa") // ৳10/km carried + ৳20/pickup
  platformFeePaisa    Int?       @map("platform_fee_paisa") // collected − driver earnings

  vehicle Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  route   Route        @relation(fields: [routeId], references: [id])
  members PoolMember[]
  events  RideEvent[]

  @@index([status, routeId])
  @@map("pools")
}

model RideRequest {
  id                 String     @id @default(uuid()) @db.Uuid
  passengerId        String     @map("passenger_id") @db.Uuid
  pickupZoneId       String     @map("pickup_zone_id") @db.Uuid
  dropoffZoneId      String     @map("dropoff_zone_id") @db.Uuid
  seats              Int
  status             RideStatus @default(REQUESTED)
  // Direct distance and the solo fare, fixed when the ride is requested.
  distanceKm         Int        @map("distance_km")
  estimatedFarePaisa Int        @map("estimated_fare_paisa")
  // Set when the trip starts (pool discount decided then).
  finalFarePaisa     Int?       @map("final_fare_paisa")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  passenger   User         @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  pickupZone  Zone         @relation("RidePickup", fields: [pickupZoneId], references: [id])
  dropoffZone Zone         @relation("RideDropoff", fields: [dropoffZoneId], references: [id])
  memberships PoolMember[]
  events      RideEvent[]

  @@index([status, createdAt])
  @@index([passengerId, createdAt])
  @@map("ride_requests")
}

// Which request is (or was) in which pool. leftAt is null while the passenger holds seats.
model PoolMember {
  id            String    @id @default(uuid()) @db.Uuid
  poolId        String    @map("pool_id") @db.Uuid
  rideRequestId String    @map("ride_request_id") @db.Uuid
  seats         Int
  pickupStop    Int       @map("pickup_stop") // route positions of this passenger's pickup
  dropoffStop   Int       @map("dropoff_stop") // and drop-off
  joinedAt      DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt        DateTime? @map("left_at") @db.Timestamptz(6) // set when dropped off or cancelled

  pool        Pool        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@map("pool_members")
}

// Append-only history: every status change of every ride request.
model RideEvent {
  id            String      @id @default(uuid()) @db.Uuid
  rideRequestId String      @map("ride_request_id") @db.Uuid
  poolId        String?     @map("pool_id") @db.Uuid
  fromStatus    RideStatus? @map("from_status")
  toStatus      RideStatus  @map("to_status")
  actorUserId   String?     @map("actor_user_id") @db.Uuid // null = the system
  reason        String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  rideRequest RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  pool        Pool?       @relation(fields: [poolId], references: [id], onDelete: SetNull)
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rideRequestId, createdAt])
  @@map("ride_events")
}
